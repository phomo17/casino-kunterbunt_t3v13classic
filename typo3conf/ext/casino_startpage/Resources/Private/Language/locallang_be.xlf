			</trans-unit>
			<trans-unit id="tt_content.CType.casino_automat.description">
				<source>Stellt einen installierten Spielautomaten im Saal auf und verlinkt ihn auf seine Spielseite. Name und Ansicht des Geräts kommen aus der Automaten-Extension.</source>
			</trans-unit>

			<trans-unit id="tt_content.tx_casinostartpage_automat">
