			<trans-unit id="strip.shooter.ein">
				<source>Würfel übernehmen</source>
			</trans-unit>
			<trans-unit id="strip.shooter.aus">
				<source>Warteliste verlassen</source>
			</trans-unit>
			<trans-unit id="strip.dran">
				<source>ist am Zug</source>
			</trans-unit>
			<trans-unit id="strip.dran.ich">
