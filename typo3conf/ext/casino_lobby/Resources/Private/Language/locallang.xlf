			<!-- Die Übersichtsseite (D4b, D.10.3) — die Schlüssel werden hier
			     bereits reserviert, weil diese Datei laut Plan (Abschnitt
			     4.10) in D4a vollständig entsteht; benutzt werden sie erst
			     ab D4b. Verbindliche Platzhalter-Schreibweise ausschließlich
			     {0}, {1}, {2} — niemals %s (Lehre aus Audit-Befund H-02:
			     diese Extension benutzt kein <f:translate>, Entscheidung
			     4.0.7 des Plans, also ist {0} die einzig richtige Form). -->
			<trans-unit id="uebersicht.titel">
				<source>An welchem Tisch möchtest du spielen?</source>
			</trans-unit>
			<trans-unit id="uebersicht.spiel.roulette">
				<source>Roulette</source>
			</trans-unit>
			<trans-unit id="uebersicht.spiel.blackjack">
				<source>Blackjack</source>
			</trans-unit>
			<trans-unit id="uebersicht.spiel.craps">
				<source>Craps</source>
			</trans-unit>
			<trans-unit id="uebersicht.einleitung">
				<source>An diesem Tisch wird schon gespielt. Setz dich dazu oder mach einen neuen Tisch auf.</source>
			</trans-unit>
