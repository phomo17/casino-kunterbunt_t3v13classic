			</trans-unit>

			<!-- Ansagen und Meldungen (D4c, D.12) -->
			<trans-unit id="ansage.dazu">
				<source>{0} ist dazugekommen.</source>
			</trans-unit>
			<trans-unit id="ansage.weg">
				<source>{0} ist aufgestanden.</source>
			</trans-unit>
			<trans-unit id="meldung.weg">
