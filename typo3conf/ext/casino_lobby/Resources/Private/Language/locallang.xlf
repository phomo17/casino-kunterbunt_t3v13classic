			</trans-unit>
			<trans-unit id="uebersicht.neu">
				<source>Neuen Tisch aufmachen</source>
			</trans-unit>
			<trans-unit id="uebersicht.neu.aus">
				<source>Mehr als {0} Tische gibt es bei diesem Spiel nicht.</source>
			</trans-unit>
			<trans-unit id="uebersicht.alles.voll">
				<source>Alle Plätze sind belegt. Sobald einer frei wird, kannst du dich setzen.</source>
			</trans-unit>

